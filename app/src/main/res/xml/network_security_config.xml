<?xml version="1.0" encoding="utf-8"?>
<!--
    ScreenSmithy Network Security Configuration

    Security Trade-off Documentation:
    1. Modern production deployments should exclusively use HTTPS.
    2. However, ScreenSmithy is specifically designed for enterprise and local kiosk environments
       (such as internal status displays, digital signage on isolated LANs, and device dashboards)
       where self-hosted HTTP endpoints (e.g. http://192.168.x.x or http://intranet-dash) are common.
    3. We permit cleartext HTTP so that administrators can intentionally configure internal HTTP
       content sources. Transport insecurity is explicitly surfaced to the administrator in Phase 04/07
       via warning diagnostics.
    4. Crucially, TLS certificate errors on HTTPS connections are NEVER bypassed or ignored.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
