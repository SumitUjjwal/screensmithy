<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialogLogsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dialog_scrim"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardLogs"
        android:layout_width="960dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_card_glow"
        android:paddingHorizontal="32dp"
        android:paddingVertical="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtLogsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Recent Diagnostic Logs"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtLogsSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sanitized, bounded in-memory diagnostic buffer (Max 200 entries)"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtLogsTitle" />

        <!-- Scrollable log viewer container -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollLogContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_status_badge"
            android:backgroundTint="@color/surface_card"
            android:fillViewport="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="16dp"
            app:layout_constraintBottom_toTopOf="@id/rowLogsActions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtLogsSubtitle">

            <TextView
                android:id="@+id/txtLogEntries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:text="No logs recorded yet."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/rowLogsActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <Button
                android:id="@+id/btnClearLogs"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_focus_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="Clear Buffer"
                android:textAllCaps="false"
                android:textColor="@color/status_error_text"
                android:textSize="13sp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnCloseLogs"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="2"
                android:background="@drawable/bg_focus_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="Close Logs"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:backgroundTint="@null" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
