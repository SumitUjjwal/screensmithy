<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialogWifiTransferRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dialog_scrim"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="24dp">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollWifiTransfer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintWidth_max="940dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardWifiTransfer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_glow"
            android:paddingHorizontal="32dp"
            android:paddingVertical="24dp">

            <!-- Title & Status Badge -->
            <TextView
                android:id="@+id/txtTransferTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Transfer HTML from Another Device"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/badgeSessionTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="@color/status_success_container"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="● Session Active (Expires in 05:00)"
                android:textColor="@color/status_success_text"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTransferTitle" />

            <!-- Network Diagnostic Error Container (Hidden by default) -->
            <LinearLayout
                android:id="@+id/containerNetworkError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="@color/status_error_container"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/badgeSessionTimer"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/txtNetworkErrorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="No Usable Local Network Detected"
                    android:textColor="@color/status_error_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtNetworkErrorDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ScreenSmithy requires an active Wi-Fi or Ethernet connection on the local network to accept HTML uploads from a phone or laptop."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnRetryNetwork"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_focus_button"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingHorizontal="16dp"
                    android:text="Retry Network Connection"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- Main Active Session Content Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerActiveSession"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/containerNetworkError">

                <!-- Left Column: High-contrast QR Code -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardQrContainer"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/imgQrCode"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="QR Code for Wi-Fi Transfer"
                        android:padding="8dp"
                        android:scaleType="fitCenter" />
                </androidx.cardview.widget.CardView>

                <!-- Right Column: Address, Pairing Code, & Instructions -->
                <LinearLayout
                    android:id="@+id/colSessionDetails"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cardQrContainer"
                    app:layout_constraintTop_toTopOf="@id/cardQrContainer">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Scan the QR code or enter in your browser:"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtTransferUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="http://192.168.1.100:8080"
                        android:textColor="@color/brand_accent"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="2. Enter this 6-digit pairing code:"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtPairingCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.25"
                        android:text="482 915"
                        android:textColor="@color/text_primary"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="3. Select a single .html or .htm file (up to 25 MB) and click Send to TV."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Transfer Status and Progress Bar -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/boxTransferStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_status_badge"
                    android:backgroundTint="@color/surface_card"
                    android:padding="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardQrContainer">

                    <TextView
                        android:id="@+id/lblTransferStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Transfer Status:"
                        android:textColor="@color/brand_accent"
                        android:textSize="13sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/txtTransferStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Waiting for sender connection over local Wi-Fi..."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/lblTransferStatus" />

                    <ProgressBar
                        android:id="@+id/progressTransfer"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="0"
                        android:progressBackgroundTint="@color/surface_card_border"
                        android:progressTint="@color/brand_primary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtTransferStatus" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Success Info Card (Displayed after successful upload) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardUploadSuccess"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_status_badge"
                    android:backgroundTint="@color/status_success_container"
                    android:padding="14dp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/boxTransferStatus"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/txtSuccessTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="✓ File Upload Succeeded"
                        android:textColor="@color/status_success_text"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/txtUploadedFileInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="dashboard.html (1.2 MB)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtSuccessTitle" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Bottom Remote Action Controls -->
            <LinearLayout
                android:id="@+id/rowTransferBottomActions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/containerActiveSession">

                <Button
                    android:id="@+id/btnPreviewTransferred"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_focus_button"
                    android:enabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text="Preview Content"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_accent"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:backgroundTint="@null"
                    tools:visibility="visible" />

                <Button
                    android:id="@+id/btnConfirmActivate"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_focus_button"
                    android:enabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text="Confirm &amp; Activate"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:backgroundTint="@null"
                    tools:visibility="visible" />

                <Button
                    android:id="@+id/btnCancelSession"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_focus_button"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text="Cancel &amp; Close"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
