<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".MainActivity">

    <!-- 1. Fullscreen Kiosk WebView Renderer (Presentation Screen) -->
    <!-- Notice: When visible, NO admin buttons are shown on screen. Admin gate is hidden remote sequence. -->
    <com.screensmithy.app.ui.renderer.KioskWebView
        android:id="@+id/kioskWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 2. Candidate Preview Control Bar (Visible only when Previewing) -->
    <LinearLayout
        android:id="@+id/previewBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D90F172A"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/txtPreviewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="👁 PREVIEW MODE — Content verification in progress"
            android:textColor="@color/brand_accent"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnConfirmPreview"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_focus_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="16dp"
            android:text="Confirm &amp; Activate"
            android:textAllCaps="false"
            android:textColor="@color/brand_accent"
            android:textSize="13sp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnExitPreview"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_focus_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="16dp"
            android:text="Exit Preview"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- 3. Setup Wizard Overlay Container (Visible during first run or when setup required) -->
    <include
        android:id="@+id/includeSetupWizard"
        layout="@layout/view_setup_wizard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="gone" />

    <!-- 4. Recoverable Configuration Error Card (Visible when configuration cannot be presented) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardError"
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_glow"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <TextView
            android:id="@+id/txtErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Configuration Error"
            android:textColor="@color/status_error_text"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtErrorDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtErrorTitle"
            tools:text="Unable to load configured content." />

        <TextView
            android:id="@+id/txtErrorRecoveryStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/brand_accent"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtErrorDetails"
            tools:text="Retrying automatically in 15 seconds (Attempt 1 of 3)..."
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/layoutErrorActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtErrorRecoveryStatus">

            <Button
                android:id="@+id/btnErrorRetry"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_focus_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="24dp"
                android:text="↻ Retry Loading"
                android:textAllCaps="false"
                android:textColor="@color/brand_accent"
                android:textSize="14sp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnErrorOpenAdmin"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_focus_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="24dp"
                android:text="Open Admin Settings (PIN Required)"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:backgroundTint="@null" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
